{
  "version": 2,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/vivah-puja-in-hyderabad",
      "destination": "https://www.northhindipandit.in/",
      "permanent": true
    },
    {
      "source": "/griha-pravesh-puja-in-hyderabad",
      "destination": "https://www.northhindipandit.in/",
      "permanent": true
    },
    {
      "source": "/satyanarayan-puja-in-hyderabad",
      "destination": "https://www.northhindipandit.in/",
      "permanent": true
    },
    {
      "source": "/rudrabhishek-puja-in-hyderabad",
      "destination": "https://www.northhindipandit.in/",
      "permanent": true
    },
    {
      "source": "/vastu-shanti-puja-in-hyderabad",
      "destination": "https://www.northhindipandit.in/",
      "permanent": true
    },
    {
      "source": "/pandit-in-hyderabad",
      "destination": "https://www.northhindipandit.in/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)vercel\\.app"
        }
      ],
      "destination": "https://www.northhindipandit.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "northhindipandit.in"
        }
      ],
      "destination": "https://www.northhindipandit.in/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
